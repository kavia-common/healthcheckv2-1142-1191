# Example environment variables for healthcheckv2
# Do not commit real secrets. Copy to .env and fill values for your environment.

# Optional: override config path
HEALTHCHECK_CONFIG=/app/config/config.yaml

# Optional: override environment name
HEALTHCHECK_ENV=dev

# Optional Kafka secrets (if Kafka SASL is used, prefer YAML for non-secrets and envs for secrets)
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Optional redaction in logger (these will be redacted in process env after logger init)
KAFKA_PASSWORD=
SASL_PASSWORD=
